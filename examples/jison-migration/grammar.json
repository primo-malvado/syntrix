{
  "startSymbol": "entry",
  "operators": [
    ["left", "+"],
    ["left", "*"]
  ],
  "lex": {
    "rules": [
      ["\\s+", "/* skip whitespace */"],
      ["[0-9]+", "return \"NUMBER\";"],
      ["\\+", "return \"+\";"],
      ["\\*", "return \"*\";"],
      ["\\(", "return \"(\";"],
      ["\\)", "return \")\";"]
    ]
  },
  "bnf": {
    "entry": [
      ["expression", "$$ = $1;"]
    ],
    "expression": [
      ["expression \"+\" expression", "$$ = $1 + $3;"],
      ["expression \"*\" expression", "$$ = $1 * $3;"],
      ["\"(\" expression \")\"", "$$ = $2;"],
      ["NUMBER", "$$ = Number(yytext);"]
    ]
  }
}
