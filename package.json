{
  "name": "syntrix",
  "version": "0.0.2",
  "description": "Modern EBNF lexer and parser toolkit for JavaScript with LALR, LR, GLR and incremental parsing.",
  "repository": {
    "type": "git",
    "url": "https://github.com/primo-malvado/syntrix.git"
  },
  "homepage": "https://primo-malvado.github.io/syntrix/",
  "type": "module",
  "main": "./src/client/index.js",
  "types": "./src/client/index.d.ts",
  "files": [
    "bin/",
    "examples/jison-migration/",
    "src/client/",
    "dist/"
  ],
  "bin": {
    "syntrix": "./bin/syntrix.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "vite build",
    "dev": "ng serve",
    "build:site": "ng build",
    "cli": "node bin/syntrix.mjs",
    "typecheck": "tsc --noEmit --strict --module nodenext --moduleResolution nodenext --target es2022 test/types.test.ts",
    "pretest": "npm run typecheck",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:compare": "node scripts/benchmark-compare.mjs",
    "benchmark:memory:compare": "node scripts/benchmark-memory-compare.mjs",
    "benchmark:memory": "node scripts/benchmark-memory.mjs",
    "benchmark:corpus": "node scripts/benchmark-corpus.mjs"
  },
  "author": "Syntrix contributors",
  "keywords": [
    "parser",
    "lexer",
    "ebnf",
    "lalr",
    "lr",
    "glr",
    "jison"
  ],
  "license": "ISC",
  "dependencies": {
  },
  "devDependencies": {
    "@angular/forms": "^22.3.0",
    "zone.js": "^0.16.3",
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "vite": "^8.3.8"
  }
}
